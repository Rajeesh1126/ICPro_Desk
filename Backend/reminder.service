[Unit]
Description=ICPro Desk reminder scheduler
Wants=network-online.target
After=network-online.target

[Service]
User=ubuntu
Type=simple
WorkingDirectory=/home/ubuntu/ProDesk/Backend

Environment="DJANGO_SETTINGS_MODULE=icprodesk.settings"
Environment="DJANGO_ENVIRONMENT=production"
Environment="DJANGO_DEBUG=False"
Environment="PYTHONUNBUFFERED=1"

Environment="REMINDER_SCHEDULER_TIME_ZONE=Asia/Kolkata"

Environment="SELF_TICKET_REMINDER_DAY_OF_WEEK=*"
Environment="SELF_TICKET_REMINDER_HOUR=10"
Environment="SELF_TICKET_REMINDER_MINUTE=0"

Environment="TIMESHEET_DAILY_REMINDER_DAY_OF_WEEK=tue-fri"
Environment="TIMESHEET_DAILY_REMINDER_HOUR=10"
Environment="TIMESHEET_DAILY_REMINDER_MINUTE=0"

Environment="TIMESHEET_WEEKLY_REMINDER_DAY_OF_WEEK=fri"
Environment="TIMESHEET_WEEKLY_REMINDER_HOUR=17"
Environment="TIMESHEET_WEEKLY_REMINDER_MINUTE=0"

# Optional server-only overrides for database, Graph credentials, and schedules.
EnvironmentFile=-/etc/icprodesk/reminder.env

ExecStart=/usr/bin/icpro_desk_scheduler.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
